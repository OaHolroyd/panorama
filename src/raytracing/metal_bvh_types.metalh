#pragma once

// Scalar layouts shared by Objective-C++ and Metal. No float3/SIMD padding.
#ifdef __METAL_VERSION__
#include "terrain_intersection.metalh"
using BvhUint = uint;
using BvhUlong = ulong;
using BvhLong = long;
#else
#include "raytrace_gpu.h"
#include <cstdint>
using BvhUint = uint32_t;
using BvhUlong = uint64_t;
using BvhLong = int64_t;
namespace panorama {
#endif

struct BvhTile {
  float x_min;
  float y_min;
  float cell_size;
  BvhUint cell_count;
  BvhUlong vertex_offset;
  int base_decimeters;
  BvhUint lod;
  BvhLong row;
  BvhLong column;
  BvhUint no_data;
};

/// Logical-cell affine patch used by transformed catalogue and detail BVHs.
struct BvhAffinePatch {
  float origin_x, origin_y;
  float column_x, column_y;
  float row_x, row_y;
  float inverse_xx, inverse_xy;
  float inverse_yx, inverse_yy;
  BvhUint minimum_column, minimum_row;
  BvhUint maximum_column, maximum_row;
  BvhUint source;
  float coverage_guard;
};

/// Vertex range for a transformed source footprint or an owned region.
/// Perimeters use shared vertices instead of independently fitted affine edges.
struct BvhCoveragePolygon {
  BvhUint vertex_offset;
  BvhUint vertex_count;
  BvhUint source;
  /// A bounds-only record skips this many following records on a miss.
  /// Leaf polygons have zero descendants; list order is preserved.
  BvhUint skip_count;
  /// Full footprints reference their owned regions in the same polygon buffer.
  BvhUint ownership_offset;
  BvhUint ownership_count;
  BvhUint coverage_offset, coverage_count;
  BvhUint blocker_offset, blocker_count;
  float minimum_x, minimum_y, maximum_x, maximum_y;
};

struct BvhCoverageVertex {
  float x, y;
};

struct BvhBlock {
  BvhUint tile;
  BvhUint x;
  BvhUint y;
  BvhUint width;
  BvhUint height;
  BvhUint transform;
};

struct BvhBounds {
  float min_x, min_y, min_z;
  float max_x, max_y, max_z;
};

struct BvhParameters {
  RaytraceParameters trace;
  BvhUint primitive_count;
  BvhUint quantized;
  BvhUint observer_source;
  BvhUint source_count;
  BvhUint hash_capacity;
  BvhUint work_count;
  BvhUint transformed_catalogue;
  BvhUint coverage_step_limit;
  BvhUint scene_resume;
  float catalogue_x, catalogue_y;
};

/// CPU/GPU continuations. Progress advances to a tile's far XY edge only
/// after that tile has been traced; cache eviction cannot erase this progress.
struct BvhRayState {
  float progress;
  // Streaming tile exit, or provisional closest-hit bound during scene repair.
  float exit;
  BvhUint source;
  BvhUint primitive;
  BvhUint done;
};

/// Indirect tile resources indexed by the instance ID in a batch TLAS.
struct BvhChunk {
#ifdef __METAL_VERSION__
  device const uchar *vertices;
  device const BvhBlock *blocks;
  device const BvhBounds *bounds;
  device const BvhAffinePatch *transforms;
#else
  BvhUlong vertices;
  BvhUlong blocks;
  BvhUlong bounds;
  BvhUlong transforms;
#endif
  BvhTile tile;
  BvhUint source;
  float vertical_offset;
  BvhUint transformed;
  BvhUint padding;
};

#ifndef __METAL_VERSION__
} // namespace panorama
#endif
