#pragma once
#include "metal_bvh_types.metalh"
#include <metal_raytracing>
using namespace metal::raytracing;

/// No reciprocal of zero, and no 0*infinity at a boundary. Bounds are inclusive.
inline bool bvh_slab(
    float origin,
    float direction,
    float low,
    float high,
    thread float &near_t,
    thread float &far_t
) {
  if (direction == 0.0F)
    return origin >= low && origin <= high;
  const float a = (low - origin) / direction;
  const float b = (high - origin) / direction;
  near_t = max(near_t, min(a, b));
  far_t = min(far_t, max(a, b));
  // Round outward instead of dropping a tangent because two axes rounded apart.
  return near_t <= far_t + 8.0F * FLT_EPSILON * max(1.0F, max(abs(near_t), abs(far_t)));
}

struct BvhIntersection {
  bool accept [[accept_intersection]];
  float distance [[distance]];
};

struct TileSelection {
  float3 world_direction;
  bool skip_resident;
  float2 origin;
  uint excluded_source;
  uint excluded_primitive;
  bool ownership_only;
};

struct SelectedTerrainTile {
  uint source;
  uint primitive;
  float entry;
  float exit;
};

inline float bvh_cross(float2 a, float2 b) { return a.x * b.y - a.y * b.x; }

/// First representable distance whose world XY point differs from a rejected
/// hit. Shadow distances can be tiny beside their world origin: nextafter(t)
/// alone can leave the ownership predicate unchanged for thousands of retries.
/// Skip only distances mapping to that same point, so no owned root is lost.
inline float bvh_next_distinct_point(float2 origin, float2 direction, float distance) {
  const float2 point = origin + distance * direction;
  float lower = distance;
  float upper = nextafter(distance, INFINITY);
  if (any(origin + upper * direction != point))
    return upper;
  float step = INFINITY;
  for (uint axis = 0; axis < 2; ++axis) {
    if (direction[axis] != 0.0F) {
      const float coordinate = nextafter(point[axis], copysign(INFINITY, direction[axis]));
      step = min(step, abs((coordinate - point[axis]) / direction[axis]));
    }
  }
  step = max(step, FLT_MIN);
  do {
    upper = max(nextafter(lower, INFINITY), distance + step);
    step *= 2.0F;
  } while (all(origin + upper * direction == point));
  // The rounded coordinates are monotonic along a ray. Locate their first
  // change rather than nudging past a potentially narrow ownership interval.
  while (nextafter(lower, INFINITY) < upper) {
    const float middle = lower + 0.5F * (upper - lower);
    if (!(middle > lower && middle < upper))
      break;
    if (all(origin + middle * direction == point))
      lower = middle;
    else
      upper = middle;
  }
  return upper;
}

inline bool bvh_point_in_polygon(
    BvhCoveragePolygon polygon,
    device const BvhCoverageVertex *vertices,
    float2 point,
    float coordinate_error
) {
  bool inside = false;
  for (uint index = 0U; index < polygon.vertex_count; ++index) {
    const BvhCoverageVertex a = vertices[polygon.vertex_offset + index];
    const BvhCoverageVertex b =
        vertices[polygon.vertex_offset + ((index + 1U) % polygon.vertex_count)];
    const float2 start = float2(a.x, a.y);
    const float2 edge = float2(b.x - a.x, b.y - a.y);
    const float edge_scale = max(1.0F, max(abs(edge.x), abs(edge.y)));
    const float along = dot(point - start, edge);
    if (abs(bvh_cross(edge, point - start)) <= coordinate_error * edge_scale && along >= 0.0F &&
        along <= dot(edge, edge))
      return true;
    const bool straddles = (a.y > point.y) != (b.y > point.y);
    if (straddles) {
      const float x = a.x + (point.y - a.y) * edge.x / (b.y - a.y);
      if (point.x < x)
        inside = !inside;
    }
  }
  return inside;
}

inline bool bvh_polygon_bounds(
    BvhCoveragePolygon polygon,
    float2 origin,
    float2 direction,
    float entry,
    float exit
) {
  return bvh_slab(origin.x, direction.x, polygon.minimum_x, polygon.maximum_x, entry, exit) &&
         bvh_slab(origin.y, direction.y, polygon.minimum_y, polygon.maximum_y, entry, exit);
}

/// Find the first horizontal-ray interval inside a coverage polygon. The
/// perimeter can be slightly non-convex after projection, so this evaluates
/// its even-odd interior instead of relying on convex half-plane clipping.
/// The small outward edge tolerance absorbs Float32 arithmetic at long range
/// but does not bridge a missing source tile.
inline bool bvh_polygon_interval(
    BvhCoveragePolygon polygon,
    device const BvhCoverageVertex *vertices,
    float2 origin,
    float2 direction,
    thread float &entry,
    thread float &exit
) {
  if (polygon.vertex_count < 3U)
    return false;
  if (!bvh_polygon_bounds(polygon, origin, direction, entry, exit))
    return false;
  const float coordinate_scale =
      max(max(1.0F, max(abs(origin.x), abs(origin.y))),
          max(max(abs(polygon.minimum_x), abs(polygon.maximum_x)),
              max(abs(polygon.minimum_y), abs(polygon.maximum_y))));
  const float coordinate_error = 8.0F * FLT_EPSILON * coordinate_scale + 1e-4F;
  // Coalesce crossings at the current position, independently of the query's
  // far limit. A distant maximum must not erase a short valid near interval.
  const float distance_error = max(1e-4F, 4.0F * FLT_EPSILON * max(1.0F, abs(entry)));
  float cursor = entry;
  for (uint interval = 0U; interval <= polygon.vertex_count; ++interval) {
    float next = exit;
    for (uint index = 0U; index < polygon.vertex_count; ++index) {
      const BvhCoverageVertex a = vertices[polygon.vertex_offset + index];
      const BvhCoverageVertex b =
          vertices[polygon.vertex_offset + ((index + 1U) % polygon.vertex_count)];
      const float2 start = float2(a.x, a.y);
      const float2 edge = float2(b.x - a.x, b.y - a.y);
      const float determinant = bvh_cross(direction, edge);
      if (abs(determinant) <= FLT_MIN)
        continue;
      const float2 relative = start - origin;
      const float distance = bvh_cross(relative, edge) / determinant;
      const float edge_fraction = bvh_cross(relative, direction) / determinant;
      if (distance > cursor + distance_error && distance < next && edge_fraction >= 0.0F &&
          edge_fraction <= 1.0F)
        next = distance;
    }
    if (next > cursor && bvh_point_in_polygon(
                             polygon,
                             vertices,
                             origin + 0.5F * (cursor + next) * direction,
                             coordinate_error
                         )) {
      entry = cursor;
      exit = next;
      return true;
    }
    if (!(next < exit))
      return false;
    cursor = next;
  }
  return false;
}

inline bool bvh_source_interval(
    BvhCoveragePolygon footprint,
    device const BvhCoveragePolygon *polygons,
    device const BvhCoverageVertex *vertices,
    bool ownership_only,
    float2 origin,
    float2 direction,
    thread float &entry,
    thread float &exit
) {
  const uint offset = ownership_only ? footprint.ownership_offset : footprint.coverage_offset;
  const uint count = ownership_only ? footprint.ownership_count : footprint.coverage_count;
  const float limit = exit;
  float cursor = entry;
  while (cursor < limit) {
    bool found = false;
    float nearest = limit, farthest = cursor;
    for (uint index = 0U; index < count; ++index) {
      const auto polygon = polygons[offset + index];
      if (polygon.skip_count != 0U) {
        if (!bvh_polygon_bounds(polygon, origin, direction, cursor, limit))
          index += polygon.skip_count;
        continue;
      }
      float start = cursor, end = limit;
      if (!bvh_polygon_interval(polygon, vertices, origin, direction, start, end))
        continue;
      // Merge connected intervals so a tessellated tile does not require a
      // fresh hardware query at every internal region edge. Disjoint intervals
      // remain separate so an empty region never acquires a surface.
      if (found && start <= farthest && end >= nearest) {
        nearest = min(nearest, start);
        farthest = max(farthest, end);
      } else if (!found || start < nearest) {
        nearest = start;
        farthest = end;
      }
      found = true;
    }
    if (!found)
      return false;
    if (!ownership_only || footprint.blocker_count == 0U) {
      entry = nearest;
      exit = farthest;
      return true;
    }
    // Subtract higher-priority coverage before scheduling a fallback segment.
    // Otherwise that segment could jump over an untraced primary island.
    float blocked_until = nearest, first_blocker = farthest;
    for (uint index = 0; index < footprint.blocker_count; ++index) {
      const auto polygon = polygons[footprint.blocker_offset + index];
      if (polygon.skip_count != 0U) {
        if (!bvh_polygon_bounds(polygon, origin, direction, nearest, farthest))
          index += polygon.skip_count;
        continue;
      }
      float start = nearest, end = farthest;
      if (!bvh_polygon_interval(polygon, vertices, origin, direction, start, end))
        continue;
      if (start <= nearest)
        blocked_until = max(blocked_until, end);
      else
        first_blocker = min(first_blocker, start);
    }
    if (blocked_until > nearest) {
      if (!(blocked_until > cursor))
        return false;
      cursor = blocked_until;
      continue;
    }
    entry = nearest;
    exit = first_blocker;
    return exit > entry;
  }
  return false;
}

inline bool bvh_owned_hit(
    uint source,
    device const BvhCoveragePolygon *polygons,
    device const BvhCoverageVertex *vertices,
    float2 point
) {
  const BvhCoveragePolygon footprint = polygons[source];
  for (uint index = 0; index < footprint.blocker_count; ++index) {
    const auto blocker = polygons[footprint.blocker_offset + index];
    if (point.x < blocker.minimum_x || point.x > blocker.maximum_x || point.y < blocker.minimum_y ||
        point.y > blocker.maximum_y) {
      index += blocker.skip_count;
      continue;
    }
    if (blocker.skip_count != 0U)
      continue;
    if (bvh_point_in_polygon(blocker, vertices, point, 0.0F))
      return false;
  }
  return true;
}

inline SelectedTerrainTile select_next_coverage_polygon(
    primitive_acceleration_structure catalogue,
    intersection_function_table<> functions,
    device const BvhCoveragePolygon *polygons,
    device const BvhCoverageVertex *vertices,
    RayDirection direction,
    float elevation,
    float progress,
    float limit,
    uint excluded_source = 0xffffffffU,
    uint excluded_primitive = 0xffffffffU,
    float2 ray_origin = float2(0.0F),
    bool ownership_only = false
) {
  ray r;
  r.origin = float3(ray_origin, elevation);
  r.direction = float3(direction.x, direction.y, direction.slope);
  r.min_distance = progress;
  r.max_distance = limit;
  intersector<> tracer;
  tracer.assume_geometry_type(geometry_type::bounding_box);
  TileSelection payload =
      {r.direction, false, ray_origin, excluded_source, excluded_primitive, ownership_only};
  const auto hit = tracer.intersect(r, catalogue, functions, payload);
  if (hit.type == intersection_type::none)
    return {0xffffffffU, 0xffffffffU, limit, limit};
  const BvhCoveragePolygon polygon = polygons[hit.primitive_id];
  float entry = progress, exit = limit;
  if (!bvh_source_interval(
          polygon,
          polygons,
          vertices,
          ownership_only,
          ray_origin,
          float2(direction.x, direction.y),
          entry,
          exit
      ))
    return {0xffffffffU, 0xffffffffU, progress, progress};
  return {polygon.source, hit.primitive_id, max(progress, entry), exit};
}

/// Find the end of continuous transformed-dataset coverage along a ray. The
/// coverage hierarchy deliberately has unbounded Z slabs; candidate culling
/// uses a separate elevation-bounded hierarchy.
inline float transformed_coverage_limit(
    primitive_acceleration_structure catalogue,
    intersection_function_table<> functions,
    device const BvhCoveragePolygon *polygons,
    device const BvhCoverageVertex *vertices,
    RayDirection direction,
    float elevation,
    float limit,
    uint step_limit,
    float2 origin = float2(0.0F),
    float progress = 0.0F
) {
  uint previous = 0xffffffffU;
  for (uint crossed = 0; crossed <= step_limit; ++crossed) {
    const SelectedTerrainTile selected = select_next_coverage_polygon(
        catalogue,
        functions,
        polygons,
        vertices,
        direction,
        elevation,
        progress,
        limit,
        0xffffffffU,
        previous,
        origin
    );
    const float tolerance = max(1e-3F, 8.0F * FLT_EPSILON * max(1.0F, progress));
    if (selected.source == 0xffffffffU || selected.entry > progress + tolerance)
      return progress;
    if (selected.exit >= limit)
      return limit;
    if (!(selected.exit > progress))
      return progress;
    progress = selected.exit;
    previous = selected.primitive;
  }
  return progress;
}

inline SelectedTerrainTile select_next_terrain_tile(
    primitive_acceleration_structure catalogue,
    intersection_function_table<> functions,
    device const BvhTile *tiles,
    RayDirection direction,
    float elevation,
    float progress,
    float limit,
    uint excluded_source = 0xffffffffU,
    uint excluded_primitive = 0xffffffffU
) {
  ray r;
  r.origin = float3(0, 0, elevation);
  r.direction = float3(direction.x, direction.y, direction.slope);
  r.min_distance = progress;
  r.max_distance = limit;
  intersector<> tracer;
  tracer.assume_geometry_type(geometry_type::bounding_box);
  TileSelection payload =
      {r.direction, false, float2(0), excluded_source, excluded_primitive, false};
  const auto hit = tracer.intersect(r, catalogue, functions, payload);
  if (hit.type == intersection_type::none)
    return {0xffffffffU, 0xffffffffU, limit, limit};
  // Callback invocation order is unspecified; use the closest primitive ID.
  const BvhTile tile = tiles[hit.primitive_id];
  const float width = tile.cell_size * float(tile.cell_count);
  float entry = 0, exit = limit;
  bvh_slab(0, r.direction.x, tile.x_min, tile.x_min + width, entry, exit);
  bvh_slab(0, r.direction.y, tile.y_min, tile.y_min + width, entry, exit);
  return {hit.primitive_id, hit.primitive_id, max(progress, entry), exit};
}
